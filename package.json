{
  "name": "emir-cards",
  "version": "1.0.0",
  "description": "Lokale Karteikarten-App mit FSRS, Offline-Modus und portablen Sicherungen",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "format": "prettier --write src tests scripts *.ts *.json *.html *.md .github/workflows/*.yml"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhemia/Emir_Anki_Project.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "bugs": {
    "url": "https://github.com/muhemia/Emir_Anki_Project/issues"
  },
  "homepage": "https://github.com/muhemia/Emir_Anki_Project#readme",
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ts-fsrs": "^5.4.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
